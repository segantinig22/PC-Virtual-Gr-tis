name: Virtual PC Build

on:
  workflow_dispatch:

jobs:
  virtual-pc:
    runs-on: ubuntu-24.04

    steps:
      - name: Prepare system
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            qemu-system-x86 \
            qemu-utils \
            wget \
            curl

      - name: Create Virtual PC
        shell: bash
        run: |
          set -e

          mkdir -p virtual-pc
          cd virtual-pc

          echo "Creating virtual disk..."

          qemu-img create \
            -f qcow2 \
            virtual-pc.qcow2 \
            20G

          echo "Downloading Linux ISO..."

          wget -q \
            https://releases.ubuntu.com/24.04/ubuntu-24.04.1-live-server-amd64.iso \
            -O ubuntu.iso

          echo "Starting Virtual PC..."

          qemu-system-x86_64 \
            -machine q35 \
            -cpu max \
            -smp 2 \
            -m 2048 \
            -drive file=virtual-pc.qcow2,format=qcow2 \
            -cdrom ubuntu.iso \
            -boot order=d \
            -netdev user,id=net0 \
            -device virtio-net-pci,netdev=net0 \
            -display none \
            -serial stdio \
            -monitor none \
            -no-reboot \
            -S &

          VM_PID=$!

          sleep 10

          if kill -0 "$VM_PID" 2>/dev/null; then
            echo "================================="
            echo " VIRTUAL PC BUILD: SUCCESS"
            echo "================================="

            kill "$VM_PID" || true
          else
            echo "Virtual PC failed to start."
            exit 1
          fi

          echo "Disk information:"
          qemu-img info virtual-pc.qcow2

      - name: Package Virtual PC
        shell: bash
        run: |
          cd virtual-pc

          cat > virtual-pc-info.txt <<'EOF'
          Virtual PC
          ==========

          Hypervisor: QEMU
          Architecture: x86_64
          CPU: 2 vCPU
          RAM: 2048 MB
          Disk: 20 GB QCOW2
          Network: User-mode networking
          Firmware: QEMU default
          EOF

          tar -czf ../virtual-pc-build.tar.gz \
            virtual-pc.qcow2 \
            virtual-pc-info.txt

      - name: Upload Virtual PC
        uses: actions/upload-artifact@v4
        with:
          name: virtual-pc-build
          path: virtual-pc-build.tar.gz
          retention-days: 7

      - name: Build completed
        run: |
          echo "======================================"
          echo "       VIRTUAL PC BUILD COMPLETE"
          echo "======================================"
          ls -lh virtual-pc-build.tar.gz
