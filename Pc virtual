name: Virtual PC

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-24.04

    steps:
      - name: Instalar QEMU
        run: |
          sudo apt-get update
          sudo apt-get install -y qemu-system-x86 qemu-utils

      - name: Criar PC Virtual
        run: |
          set -e

          mkdir -p virtual-pc

          echo "Criando disco virtual de 20 GB..."
          qemu-img create -f qcow2 virtual-pc/virtual-pc.qcow2 20G

          echo "Testando QEMU..."

          timeout 10s qemu-system-x86_64 \
            -machine q35 \
            -cpu max \
            -smp 2 \
            -m 2048 \
            -drive file=virtual-pc/virtual-pc.qcow2,format=qcow2 \
            -display none \
            -serial stdio \
            -no-reboot \
            || true

          echo "PC virtual criado com sucesso."

          qemu-img info virtual-pc/virtual-pc.qcow2

      - name: Criar pacote
        run: |
          cd virtual-pc

          cat > README.txt <<'EOF'
          PC VIRTUAL
          ===========

          Hypervisor: QEMU
          Arquitetura: x86_64
          Memória: 2048 MB
          CPU: 2 vCPU
          Disco: 20 GB
          Formato: QCOW2
          EOF

          cd ..

          tar -czf virtual-pc.tar.gz virtual-pc

      - name: Disponibilizar Build
        uses: actions/upload-artifact@v4
        with:
          name: virtual-pc
          path: virtual-pc.tar.gz
          retention-days: 7
